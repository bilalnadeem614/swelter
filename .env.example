# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here   # server-side ONLY, never in frontend

# --- FortyGuard API ---
FORTYGUARD_API_KEY=your-fortyguard-api-key-here   # confirm exact header format once docs are readable

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- Agent endpoint protection ---
CHECK_HEAT_SECRET=some-long-random-shared-secret   # sent by GitHub Actions + manual "Check Now" button

# --- Web push (desktop/Android browser notifications) ---
# generate with: python -c "from py_vapid import Vapid; ..." — see decisions.md 2026-08-30
VAPID_PUBLIC_KEY=your-vapid-public-key-here   # also set as VITE_VAPID_PUBLIC_KEY in frontend/.env
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:you@example.com